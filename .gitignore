# Ignore build artifacts and IDE files

# CMake / build
/build/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/Makefile
/install_manifest.txt
/compile_commands.json
/torch
/module_library


# Visual Studio
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/

# Build outputs
*.obj
*.o
*.exe
*.dll
*.so
*.dylib
*.lib
*.pdb
*.exp
*.ilk

# Generated project dirs
build-*/
dev_bundle/
# Local build presets
/build_test/
/build_real/
vcpkg_installed/
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env/
venv/
.venv/
.env.*
.pytest_cache/
# ML data and run artifacts (toys_to_survive_development)
/toys_to_survive_development/data/
/toys_to_survive_development/wav_pipeline_runs/
# Editors/IDEs
.vscode/
.idea/
*.swp
*~

# Node
node_modules/

# OS files
.DS_Store
Thumbs.db

# Logs, temp
*.log
*.tmp
*.bak
*.bak_*
*.cache

# Images / generated assets
*.png
*.jpg
*.jpeg
/generated_program_canvas*.txt

# Misc
*.user

# End of .gitignore
